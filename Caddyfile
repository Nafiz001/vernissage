# One origin for the browser: the Go server answers the API, the live rooms
# and every picture; Next.js renders the pages. SITE_ADDRESS is a domain
# (HTTPS, certificates managed by Caddy) or ":8080" (plain HTTP).
{$SITE_ADDRESS} {
	encode zstd gzip

	@server path /api/* /ws/* /img/* /dzi/* /poster/*
	handle @server {
		reverse_proxy server:8790
	}

	handle {
		reverse_proxy web:3790
	}
}
