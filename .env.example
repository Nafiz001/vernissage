# Server (Go)
DATABASE_URL=postgres://vernissage:vernissage@127.0.0.1:5491/vernissage?sslmode=disable
VERNISSAGE_ADDR=127.0.0.1:8790
VERNISSAGE_CACHE=data/cache
VERNISSAGE_CACHE_MB=2048
# Web origins allowed to write and open WebSockets; the first builds links.
VERNISSAGE_ORIGINS=http://localhost:3790,http://127.0.0.1:3790
VERNISSAGE_SECURE_COOKIES=false
VERNISSAGE_WORKERS=6
# Re-read the museums on this interval (e.g. 168h); empty turns it off.
VERNISSAGE_SYNC_EVERY=

# Web (Next.js)
VERNISSAGE_API=http://127.0.0.1:8790
NEXT_PUBLIC_SITE_URL=http://localhost:3790
